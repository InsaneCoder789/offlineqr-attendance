{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "types": [
      "vitest/globals"
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-build-product/types/**/*.ts",
    ".next-build-product/dev/types/**/*.ts",
    ".next-story-dev/types/**/*.ts",
    ".next-story-dev/dev/types/**/*.ts",
    ".next-image-build/types/**/*.ts",
    ".next-image-build/dev/types/**/*.ts",
    ".next-image-dev/types/**/*.ts",
    ".next-image-dev/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
